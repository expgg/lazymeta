# ==============================================================================
# LazyMeta Environment Configuration Template
# Copy this file to '.env' and fill in your Facebook Page credentials:
#   copy .env.example .env
# ==============================================================================

# 1. Your Facebook Page ID (Numeric ID found in Page Settings > About > Page ID)
META_PAGE_ID=your_facebook_page_id_here

# 2. Permanent Facebook Page Access Token
# Required permissions: 'pages_manage_posts', 'pages_read_engagement'
#
# HOW TO GENERATE A PERMANENT PAGE ACCESS TOKEN:
# 1. Go to Meta for Developers: https://developers.facebook.com/tools/explorer/
# 2. Select your App from the top-right dropdown.
# 3. Under 'User or Page', select your Facebook Page.
# 4. Under 'Permissions', add 'pages_manage_posts' and 'pages_read_engagement'.
# 5. Click 'Generate Access Token'.
# 6. (For permanent tokens) Convert to a long-lived token via Access Token Tool or
#    create a System User under Meta Business Manager with Page Admin role.
META_PAGE_ACCESS_TOKEN=your_permanent_page_access_token_here

# 3. Meta Graph API Version (defaults to v22.0)
META_GRAPH_VERSION=v22.0

# 4. Anti-Spam Rate Limit Delay (in seconds, default: 2.5s)
# Mandatory 2.0s - 3.0s delay between requests prevents Meta HTTP 429 / Code 4 blocks.
META_REQUEST_DELAY=2.5
